---
import type { Locale, ResumeContent, TimelineItem } from '../data/resume';
import { getTranslations } from '../i18n';
import profileUrl from '../../assets/profile.jpeg?url';

interface Props { locale: Locale; content: ResumeContent; }
const { locale, content } = Astro.props;
const { t } = await getTranslations(locale);
const label = (key: string) => t(key);

const timeline = (items: TimelineItem[]) => items;
const visibleExperience = content.experience.slice(0, 3);
const olderExperience = content.experience.slice(3);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-status"><span class="status-light"></span>{content.profile.availability}</div>
  <p class="eyebrow"><span class="prompt-mark">root@matias-martello:~$</span> {label('prompt')}</p>
  <h1 id="hero-title">
    <span class="profile-pixel" aria-hidden="true"><img src={profileUrl} alt="" width="400" height="400" /></span>
    <span class="name-typewriter" aria-label="Matias Martello"><span data-typewriter aria-hidden="true">Matias</span><br /><em><span data-typewriter aria-hidden="true">Martello</span><span class="cursor" aria-hidden="true"></span></em></span>
    
  </h1>
  <div class="hero-grid">
    <div>
      <p class="role">{content.profile.role}</p>
      <p class="intro">{content.profile.intro}</p>
    </div>
    <aside class="contact-card" aria-label={label('contact')}>
      <p class="command-line"><span>›</span> {label('contact')}</p>
      <a href={`mailto:${content.profile.email}`}>{content.profile.email}</a>
      <span class="location">⌖ {content.profile.location}</span>
      <button class="copy-button" data-email={content.profile.email} data-copy-label={label('copyEmail')} data-copied-label={label('copied')}>{label('copyEmail')}</button>
      <span class="cv-placeholder" aria-disabled="true">↓ {label('cv')} <small>{label('cvSoon')}</small></span>
    </aside>
  </div>
</section>

<section id="about" class="content-section about-section" aria-labelledby="about-title">
  <div class="section-command"><span class="prompt-mark">root@matias-martello:~$</span> {label('commandAbout')}</div>
  <div class="section-heading"><span class="section-index">01</span><h2 id="about-title">{label('navAbout')}</h2></div>
  <div class="about-copy">{content.about.map((paragraph) => <p>{paragraph}</p>)}</div>
  <div class="skills-grid" aria-label="Skills">
    {content.skills.map((group) => <article class="skill-group"><p class="skill-label">./{group.label}</p><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}
  </div>
</section>

<section id="experience" class="content-section" aria-labelledby="experience-title">
  <div class="section-command"><span class="prompt-mark">root@matias-martello:~$</span> {label('commandExperience')}</div>
  <div class="section-heading"><span class="section-index">02</span><h2 id="experience-title">{label('navExperience')}</h2></div>
  <div class="timeline">
    {timeline(visibleExperience).map((item) => <article class="timeline-item">
      <div class="timeline-period">{item.period}</div><div class="timeline-dot"></div>
      <div class="timeline-content"><p class="item-meta">{item.organization} · {item.location}</p><h3>{item.title}</h3><p>{item.summary}</p><ul class="highlights">{item.highlights.map((point) => <li>{point}</li>)}</ul><div class="tags">{item.tags?.map((tag) => <span>{tag}</span>)}</div></div>
    </article>)}
    {olderExperience.length > 0 && <details class="experience-more">
      <summary><span class="prompt-mark">root@matias-martello:~$</span><span class="summary-open"> {label('moreExperience')}</span><span class="summary-close"> {label('closeExperience')}</span><span class="summary-caret">↴</span></summary>
      <div class="older-timeline">
        {timeline(olderExperience).map((item) => <article class="timeline-item">
          <div class="timeline-period">{item.period}</div><div class="timeline-dot"></div>
          <div class="timeline-content"><p class="item-meta">{item.organization} · {item.location}</p><h3>{item.title}</h3><p>{item.summary}</p><ul class="highlights">{item.highlights.map((point) => <li>{point}</li>)}</ul><div class="tags">{item.tags?.map((tag) => <span>{tag}</span>)}</div></div>
        </article>)}
      </div>
    </details>}
  </div>
</section>

<section id="education" class="content-section" aria-labelledby="education-title">
  <div class="section-command"><span class="prompt-mark">root@matias-martello:~$</span> {label('commandEducation')}</div>
  <div class="section-heading"><span class="section-index">03</span><h2 id="education-title">{label('navEducation')}</h2></div>
  <div class="timeline compact-timeline">
    {timeline(content.education).map((item) => <article class="timeline-item">
      <div class="timeline-period">{item.period}</div><div class="timeline-dot"></div>
      <div class="timeline-content"><p class="item-meta">{item.organization} · {item.location}</p><h3>{item.title}</h3><p>{item.summary}</p><ul class="highlights">{item.highlights.map((point) => <li>{point}</li>)}</ul></div>
    </article>)}
  </div>
</section>

<section id="projects" class="content-section projects-section" aria-labelledby="projects-title">
  <div class="section-command"><span class="prompt-mark">root@matias-martello:~$</span> {label('commandProjects')}</div>
  <div class="section-heading"><span class="section-index">04</span><h2 id="projects-title">{label('navProjects')}</h2></div>
  <div class="project-grid">
    {content.projects.map((project, index) => <article class="project-card"><div class="project-top"><span>0{index + 1}</span><span>{project.type}</span></div><h3>{project.name}</h3><p>{project.description}</p><div class="tags">{project.stack.map((item) => <span>{item}</span>)}</div></article>)}
  </div>
</section>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const letters = [...document.querySelectorAll<HTMLElement>('[data-typewriter]')];
    const text = letters.map((letter) => letter.textContent ?? '');
    letters.forEach((letter) => { letter.textContent = ''; });

    let word = 0;
    let character = 0;
    const writeName = () => {
      if (word === letters.length) return;
      letters[word].textContent += text[word][character] ?? '';
      character += 1;
      if (character >= text[word].length) {
        word += 1;
        character = 0;
        window.setTimeout(writeName, 170);
        return;
      }
      window.setTimeout(writeName, 92);
    };
    window.setTimeout(writeName, 180);
  }

  document.querySelectorAll<HTMLButtonElement>('.copy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.email ?? '');
        const original = button.textContent;
        button.textContent = button.dataset.copiedLabel ?? original;
        setTimeout(() => { button.textContent = original; }, 1800);
      } catch { window.location.href = `mailto:${button.dataset.email ?? ''}`; }
    });
  });
</script>
